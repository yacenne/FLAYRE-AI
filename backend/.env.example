# ============================================
# flayre.ai Backend Environment Variables
# ============================================

# App Configuration
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# OpenRouter AI (Primary Cloud Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
PRIMARY_MODEL=bytedance-seed/seed-1.6-flash
FAST_MODEL=bytedance-seed/seed-1.6-flash
VISION_MODEL=bytedance-seed/seed-1.6-flash

# Ollama AI (Local / Ollama Cloud Alternative)
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=qwen3-vl:latest

# Supabase (Database & Authentication)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Razorpay (Payments & Subscriptions)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Rate Limits
FREE_TIER_MONTHLY_LIMIT=10
PRO_TIER_MONTHLY_LIMIT=999999
